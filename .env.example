# ===== 使用说明 =====
# 1) 复制本文件为 .env（同目录），填入自己的密钥即可；.env 已被 .gitignore 忽略。
# 2) 或者执行 `python -m fva.cli setup`，按提示输入密钥（会隐藏输入并自动做连通性自检）。
# 3) 验证是否生效：`python -m fva.cli info` 与 `python -m fva.cli check`。
# 4) 环境变量的优先级高于本文件；如果你在系统里 `setx` 过同名变量，请先清理。

# ===== 大模型接入（OpenAI Chat Completions 兼容协议）=====
# 默认指向 DeepSeek 官方接口；任何兼容端点（中转网关、vLLM、Ollama OpenAI 模式）都可替换。
FVA_LLM_BASE_URL=https://api.deepseek.com
FVA_LLM_API_KEY=
FVA_LLM_MODEL=deepseek-chat
FVA_LLM_TEMPERATURE=0.0
FVA_LLM_MAX_TOKENS=2048
FVA_LLM_TIMEOUT=120

# ===== 智能体预算（控制单样本成本与兜底）=====
FVA_AGENT_MAX_STEPS=12
FVA_AGENT_MAX_TOOL_CALLS=20
FVA_AGENT_MIN_REPO_CHECKS=1
FVA_AGENT_MAX_KB_HITS=5

# ===== 仓库快照 =====
# 未配置 Token 时 GitHub API 为 60 次/小时，建议填一个只读 Token
FVA_SNAPSHOT_MAX_MB=300
FVA_SNAPSHOT_TIMEOUT=300
FVA_REPO_ENABLED=1
FVA_GITHUB_TOKEN=
